PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=
# Supabase Connect > Session pooler. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-REGION.pooler.supabase.com:5432/postgres
# Download the project's database CA certificate; never disable TLS verification.
DATABASE_SSL=true
DATABASE_CA_FILE=
# Optional. Set false to store new strokes as JSONB while keeping mixed-format reads.
DRAWING_PACKED=true
CLERK_PUBLISHABLE_KEY=pk_test_your-publishable-key-here
CLERK_SECRET_KEY=sk_test_your-secret-key-here
# Required to enable sharing or retrieve HMAC invitations. Use 32 random bytes as 64 hex characters.
# Keep this backend-only key unchanged across restarts/deploys; do not reuse a Clerk secret.

# Chat at rest: separate 32-byte key (64 hex characters). Preserve it to decrypt saved messages.
# Generate locally with node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CHAT_ENCRYPTION_KEY=
